menu "K-FSW services"

config KFSW_LOG_MIN_LEVEL
	int "Minimum K-FSW log level"
	range 0 4
	default 1
	help
	  Compile messages at or above this severity. Values are 0 for DEBUG,
	  1 for INFO, 2 for WARNING, 3 for ERROR, and 4 to disable logging.

config KFSW_PARAM
	bool "K-FSW parameter service"
	select CBPRINTF_FP_SUPPORT
	help
	  Enable the deterministic local K-FSW parameter table and API. This
	  capability does not require CSP; persistence remains a local option.

if KFSW_PARAM

config KFSW_PARAM_PERSISTENCE
	bool "Explicit LittleFS parameter snapshots"
	depends on KFSW_STORAGE
	select CRC
	help
	  Save and restore explicitly selected local parameters using a bounded,
	  versioned snapshot under /kfsw/params. Runtime parameter changes remain
	  in RAM until an explicit save operation.

endif # KFSW_PARAM

config KFSW_PARAM_CSP
	bool "K-FSW parameter CSP adapter"
	depends on KFSW_PARAM && KFSW_CSP
	help
	  Expose the local parameter table over the established libparam CSP wire
	  protocol and enable remote parameter client/cache operations.

if KFSW_PARAM_CSP

config KFSW_PARAM_PORT
	int "CSP parameter transaction port"
	range 1 63
	default 10
	help
	  CSP port used for libparam version 2 pull and push transactions.
	  Upstream libparam currently defaults to port 10.

config KFSW_PARAM_LIST_PORT
	int "CSP parameter-list port"
	range 1 63
	default 12
	help
	  CSP port used by the upstream version 3 parameter-list wire format.

config KFSW_PARAM_REMOTE_POOL_SIZE
	int "Preallocated remote parameter descriptors"
	range 5 64
	default 16
	help
	  Number of remote parameter descriptions cached without dynamic memory.

config KFSW_PARAM_TIMEOUT_MS
	int "Remote parameter timeout in milliseconds"
	range 10 60000
	default 1000

config KFSW_PARAM_LIST_STACK_SIZE
	int "Parameter-list server thread stack size"
	default 2048

config KFSW_PARAM_LIST_PRIORITY
	int "Parameter-list server thread priority"
	default 1

endif # KFSW_PARAM_CSP

config KFSW_FTP
	bool "K-FSW file transfer service"
	depends on KFSW_CSP && KFSW_STORAGE
	select CRC
	help
	  Enable the bounded K-FSW file transfer client and server. All paths are
	  sandboxed below /kfsw/ftp and all CSP connections require RDP and CRC32.

if KFSW_FTP

config KFSW_FTP_CSP_PORT
	int "CSP file transfer port"
	range 1 63
	default 9

config KFSW_FTP_TIMEOUT_MS
	int "File transfer receive timeout in milliseconds"
	range 1000 120000
	default 15000
	help
	  Timeout for each protocol message. This must remain longer than the
	  libcsp RDP connection timeout used by the application.

config KFSW_FTP_WORKER_STACK_SIZE
	int "File transfer worker thread stack size"
	range 1024 16384
	default 3072

config KFSW_FTP_WORKER_PRIORITY
	int "File transfer worker thread priority"
	default 2

config KFSW_FTP_ACCEPTOR_STACK_SIZE
	int "File transfer acceptor thread stack size"
	range 768 8192
	default 1536

config KFSW_FTP_ACCEPTOR_PRIORITY
	int "File transfer acceptor thread priority"
	default 2

endif # KFSW_FTP

config KFSW_EVENT
	bool "K-FSW structured event record"
	help
	  Record numeric events in a bounded RAM ring: stable identifier,
	  monotonic timestamp, sequence number and a small opaque payload. This
	  is the record an operator reads after the fact; it does not replace
	  the console log. The ring does not survive a reset.

if KFSW_EVENT

config KFSW_EVENT_RING_DEPTH
	int "Recorded events held in memory"
	range 8 256
	default 32
	help
	  When the ring is full the oldest record is overwritten and the
	  overwritten counter increases, so lost history stays visible.

endif # KFSW_EVENT

config KFSW_COMMAND
	bool "K-FSW command service"
	help
	  Enable the command registry. Commands are contributed as compile-time
	  sets by their owning component and reached by name from the shell or
	  by numeric identifier over CSP, through one validation path.

if KFSW_COMMAND

config KFSW_COMMAND_MAX_COMMANDS
	int "Maximum registered commands"
	range 4 64
	default 16
	help
	  Bounds the static registry. Startup fails if the composed definition
	  sets exceed this count.

config KFSW_COMMAND_CSP
	bool "Expose commands over CSP"
	depends on KFSW_CSP
	help
	  Serve command requests on a dedicated CSP port. Without this the
	  registry is reachable only from local callers such as the shell.

if KFSW_COMMAND_CSP

config KFSW_COMMAND_CSP_PORT
	int "CSP command port"
	range 1 63
	default 11
	help
	  Distinct from file transfer (9) and the parameter adapter (10, 12).

config KFSW_COMMAND_TIMEOUT_MS
	int "Command receive timeout in milliseconds"
	range 1000 120000
	default 10000

config KFSW_COMMAND_SERVER_STACK_SIZE
	int "Command server thread stack size"
	range 1024 16384
	default 3072

config KFSW_COMMAND_SERVER_PRIORITY
	int "Command server thread priority"
	default 2

endif # KFSW_COMMAND_CSP

endif # KFSW_COMMAND

config KFSW_FWU
	bool "K-FSW firmware update"
	depends on FLASH
	depends on FLASH_MAP
	select STREAM_FLASH
	select CRC
	help
	  Receive a firmware image into the secondary image slot selected by the
	  kfsw,fwu-partition devicetree chosen property, verify it against a
	  CRC32, and offer it to the bootloader.

	  The image is streamed into raw flash rather than staged as a file. An
	  application image is larger than the filesystem partition on the first
	  target, so staging it as a file is not possible there.

config KFSW_FWU_MCUBOOT
	bool "Offer completed images to MCUboot"
	depends on KFSW_FWU
	depends on BOOTLOADER_MCUBOOT
	depends on IMG_MANAGER
	default y
	help
	  Mark a completed image to be tried on the next boot, and confirm that
	  the bootloader actually scheduled a swap.

	  Turn this off to receive and verify images without asking for a
	  reboot, which is what the unit tests do: they exercise the transfer
	  and its rejections on a target that has no bootloader.

config KFSW_FWU_SLOT_OFFSET_SECTORS
	int "Sectors to skip at the start of the target slot"
	depends on KFSW_FWU
	default 1
	range 0 8
	help
	  MCUboot's swap-using-offset mode requires an update to be written one
	  sector into the secondary slot rather than at its start. Writing at
	  the start is not rejected: the bootloader finds nothing to swap and
	  carries on with the old image, which from the ground is
	  indistinguishable from a successful update.

	  Set to 0 only for a bootloader whose swap mode places the image at the
	  slot start.

config KFSW_FWU_LITE
	bool "K-FSW lightweight firmware upload"
	depends on KFSW_FWU
	select CRC
	help
	  A direct path for putting a firmware image on a node, alongside the
	  file transfer route. Both feed the same update service and may be
	  built together; whichever starts a transfer first holds it and the
	  other is told the service is busy.

	  Blocks carry their own checksum and are checked before anything is
	  written. A whole-image checksum tells you an eight minute upload
	  failed; a per-block one tells you which block to send again.

config KFSW_FWU_LITE_BLOCK_SIZE
	int "Image block size in bytes"
	depends on KFSW_FWU_LITE
	default 192
	range 16 512
	help
	  Payload carried by one block message. The default matches the file
	  transfer chunk, which is sized so a message and its transport overhead
	  fit one CSP buffer.

	  Every block but the last must be exactly this size: the receiving node
	  works out which block it expects from how much it already holds, and a
	  short block in the middle would desynchronise the two without either
	  noticing.

config KFSW_FWU_LITE_CSP
	bool "Serve lightweight firmware upload over CSP"
	depends on KFSW_FWU_LITE
	depends on KFSW_CSP
	default y
	help
	  Bind the upload server to a CSP port and provide the sending side.
	  Turn this off to build the protocol without a transport, which is what
	  the unit tests do.

config KFSW_FWU_LITE_CSP_PORT
	int "CSP port for firmware upload"
	depends on KFSW_FWU_LITE_CSP
	default 13
	range 0 63
	help
	  Ports in use: 9 file transfer, 10 parameter transactions, 11 commands,
	  12 parameter list.

config KFSW_FWU_LITE_RDP
	bool "Use reliable delivery for firmware upload"
	depends on KFSW_FWU_LITE_CSP
	default n
	help
	  Off by default. The per-block checksum and repeat already recover
	  losses, and adding a second retry mechanism underneath brings
	  connection state and timeouts that can stall a transfer on a marginal
	  link instead of reporting the block that needs resending.

config KFSW_FWU_LITE_TIMEOUT_MS
	int "Reply timeout in milliseconds"
	depends on KFSW_FWU_LITE_CSP
	default 8000
	range 100 60000

config KFSW_FWU_LITE_HOST_FILES
	bool "Read images straight from the host filesystem"
	depends on KFSW_FWU_LITE_CSP
	depends on ARCH_POSIX
	default y
	help
	  Where a node runs as a process on a host, let it send an image from a
	  host path rather than requiring the image to be copied into its
	  simulated flash first. A ground station already has the image on the
	  machine it runs on, and a firmware image is larger than the storage
	  partition it would otherwise have to be staged in.

	  A path under the node's own mount point is a node file; anything else
	  is a host path. The distinction is positional rather than guessed, and
	  no board can take the host branch because it is not compiled there.

config KFSW_FWU_LITE_STACK_SIZE
	int "Upload server stack size in bytes"
	depends on KFSW_FWU_LITE_CSP
	default 2048
	range 1024 8192

config KFSW_FWU_LITE_PRIORITY
	int "Upload server thread priority"
	depends on KFSW_FWU_LITE_CSP
	default 3

config KFSW_FWU_LITE_BLOCK_RETRIES
	int "Times to repeat a block the node did not accept"
	depends on KFSW_FWU_LITE_CSP
	default 4
	range 0 32

config KFSW_FTP_FIRMWARE_PATH
	string "Reserved upload path that routes to the firmware slot"
	depends on KFSW_FWU
	depends on KFSW_FTP
	default "firmware.bin"
	help
	  A put to this path inside the transfer root is written into the
	  firmware update slot instead of the filesystem. The client sends the
	  size and CRC32 the update service needs as part of an ordinary put,
	  so nothing about the wire protocol changes.

	  The name is reserved: a file uploaded to it is never stored. It is
	  still safe, because an image that is not a valid signed firmware is
	  refused by the bootloader and the previous image continues to run.

config KFSW_FWU_STREAM_BUFFER_SIZE
	int "Flash write buffer size in bytes"
	depends on KFSW_FWU
	default 512
	range 64 4096
	help
	  Staging buffer between arriving chunks and the flash write block. Must
	  be a multiple of the flash write block size.

endmenu
