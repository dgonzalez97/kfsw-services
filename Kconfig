menu "K-FSW services"

config KFSW_LOG_MIN_LEVEL
	int "Minimum K-FSW log level"
	range 0 4
	default 1
	help
	  Compile messages at or above this severity. Values are 0 for DEBUG,
	  1 for INFO, 2 for WARNING, 3 for ERROR, and 4 to disable logging.

config KFSW_PARAM
	bool "K-FSW parameter service"
	depends on KFSW_CSP
	select CBPRINTF_FP_SUPPORT
	help
	  Enable the deterministic K-FSW parameter table and the libparam-based
	  local and CSP client/server APIs.

if KFSW_PARAM

config KFSW_PARAM_PERSISTENCE
	bool "Explicit LittleFS parameter snapshots"
	depends on KFSW_STORAGE
	select CRC
	help
	  Save and restore explicitly selected local parameters using a bounded,
	  versioned snapshot under /kfsw/params. Runtime parameter changes remain
	  in RAM until an explicit save operation.

config KFSW_PARAM_PORT
	int "CSP parameter transaction port"
	range 1 63
	default 10
	help
	  CSP port used for libparam version 2 pull and push transactions.
	  Upstream libparam currently defaults to port 10.

config KFSW_PARAM_LIST_PORT
	int "CSP parameter-list port"
	range 1 63
	default 12
	help
	  CSP port used by the upstream version 3 parameter-list wire format.

config KFSW_PARAM_REMOTE_POOL_SIZE
	int "Preallocated remote parameter descriptors"
	range 5 64
	default 16
	help
	  Number of remote parameter descriptions cached without dynamic memory.

config KFSW_PARAM_TIMEOUT_MS
	int "Remote parameter timeout in milliseconds"
	range 10 60000
	default 1000

config KFSW_PARAM_LIST_STACK_SIZE
	int "Parameter-list server thread stack size"
	default 2048

config KFSW_PARAM_LIST_PRIORITY
	int "Parameter-list server thread priority"
	default 1

endif # KFSW_PARAM

endmenu
