menu "K-FSW services"

config KFSW_LOG_MIN_LEVEL
	int "Minimum K-FSW log level"
	range 0 4
	default 1
	help
	  Compile messages at or above this severity. Values are 0 for DEBUG,
	  1 for INFO, 2 for WARNING, 3 for ERROR, and 4 to disable logging.

config KFSW_PARAM
	bool "K-FSW parameter service"
	select CBPRINTF_FP_SUPPORT
	help
	  Enable the deterministic local K-FSW parameter table and API. This
	  capability does not require CSP; persistence remains a local option.

if KFSW_PARAM

config KFSW_PARAM_PERSISTENCE
	bool "Explicit LittleFS parameter snapshots"
	depends on KFSW_STORAGE
	select CRC
	help
	  Save and restore explicitly selected local parameters using a bounded,
	  versioned snapshot under /kfsw/params. Runtime parameter changes remain
	  in RAM until an explicit save operation.

endif # KFSW_PARAM

config KFSW_PARAM_CSP
	bool "K-FSW parameter CSP adapter"
	depends on KFSW_PARAM && KFSW_CSP
	help
	  Expose the local parameter table over the established libparam CSP wire
	  protocol and enable remote parameter client/cache operations.

if KFSW_PARAM_CSP

config KFSW_PARAM_PORT
	int "CSP parameter transaction port"
	range 1 63
	default 10
	help
	  CSP port used for libparam version 2 pull and push transactions.
	  Upstream libparam currently defaults to port 10.

config KFSW_PARAM_LIST_PORT
	int "CSP parameter-list port"
	range 1 63
	default 12
	help
	  CSP port used by the upstream version 3 parameter-list wire format.

config KFSW_PARAM_REMOTE_POOL_SIZE
	int "Preallocated remote parameter descriptors"
	range 5 64
	default 16
	help
	  Number of remote parameter descriptions cached without dynamic memory.

config KFSW_PARAM_TIMEOUT_MS
	int "Remote parameter timeout in milliseconds"
	range 10 60000
	default 1000

config KFSW_PARAM_LIST_STACK_SIZE
	int "Parameter-list server thread stack size"
	default 2048

config KFSW_PARAM_LIST_PRIORITY
	int "Parameter-list server thread priority"
	default 1

endif # KFSW_PARAM_CSP

config KFSW_FTP
	bool "K-FSW file transfer service"
	depends on KFSW_CSP && KFSW_STORAGE
	select CRC
	help
	  Enable the bounded K-FSW file transfer client and server. All paths are
	  sandboxed below /kfsw/ftp and all CSP connections require RDP and CRC32.

if KFSW_FTP

config KFSW_FTP_CSP_PORT
	int "CSP file transfer port"
	range 1 63
	default 9

config KFSW_FTP_TIMEOUT_MS
	int "File transfer receive timeout in milliseconds"
	range 1000 120000
	default 15000
	help
	  Timeout for each protocol message. This must remain longer than the
	  libcsp RDP connection timeout used by the application.

config KFSW_FTP_WORKER_STACK_SIZE
	int "File transfer worker thread stack size"
	range 1024 16384
	default 3072

config KFSW_FTP_WORKER_PRIORITY
	int "File transfer worker thread priority"
	default 2

config KFSW_FTP_ACCEPTOR_STACK_SIZE
	int "File transfer acceptor thread stack size"
	range 768 8192
	default 1536

config KFSW_FTP_ACCEPTOR_PRIORITY
	int "File transfer acceptor thread priority"
	default 2

endif # KFSW_FTP

config KFSW_COMMAND
	bool "K-FSW command service"
	help
	  Enable the command registry. Commands are contributed as compile-time
	  sets by their owning component and reached by name from the shell or
	  by numeric identifier over CSP, through one validation path.

if KFSW_COMMAND

config KFSW_COMMAND_MAX_COMMANDS
	int "Maximum registered commands"
	range 4 64
	default 16
	help
	  Bounds the static registry. Startup fails if the composed definition
	  sets exceed this count.

config KFSW_COMMAND_CSP
	bool "Expose commands over CSP"
	depends on KFSW_CSP
	help
	  Serve command requests on a dedicated CSP port. Without this the
	  registry is reachable only from local callers such as the shell.

if KFSW_COMMAND_CSP

config KFSW_COMMAND_CSP_PORT
	int "CSP command port"
	range 1 63
	default 11
	help
	  Distinct from file transfer (9) and the parameter adapter (10, 12).

config KFSW_COMMAND_TIMEOUT_MS
	int "Command receive timeout in milliseconds"
	range 1000 120000
	default 10000

config KFSW_COMMAND_SERVER_STACK_SIZE
	int "Command server thread stack size"
	range 1024 16384
	default 3072

config KFSW_COMMAND_SERVER_PRIORITY
	int "Command server thread priority"
	default 2

endif # KFSW_COMMAND_CSP

endif # KFSW_COMMAND

endmenu
